# Copy this file to .env and fill in real values. Never commit the real .env file.

# Server
PORT=5000
NODE_ENV=development

# MongoDB (local)
MONGO_URI=mongodb://127.0.0.1:27017/crsp

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Image uploads: LOCAL disk storage is used by default (fully working,
# zero external setup). Uploaded files are served from /uploads on this
# server. If you want to use Cloudinary instead, fill these in AND set
# USE_CLOUDINARY=true. Until then, local storage is used automatically.
# ---------------------------------------------------------------------------
USE_CLOUDINARY=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
